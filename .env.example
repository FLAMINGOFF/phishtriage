# Copy to .env and adjust. docker compose reads .env automatically.
# .env is git-ignored and excluded from the Docker build context: keep it that way.

# ----------------------------------------------------------------- runtime
APP_ENV=dev
LOG_LEVEL=INFO
# Required in production (APP_ENV=prod refuses the built-in dev key). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ----------------------------------------------------------------- analyst console
# Session cookie only over HTTPS. The compose demo sets false (plain http on localhost);
# APP_ENV=prod refuses false. Accounts: python -m app.cli create-user EMAIL --role admin
# SESSION_COOKIE_SECURE=true
# SESSION_IDLE_MINUTES=60
# SESSION_MAX_HOURS=12

# ----------------------------------------------------------------- REST API
# Bearer token for POST /api/reports (at least 32 characters). Empty = API disabled.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ----------------------------------------------------------------- demo stack passwords
# Used by docker-compose.yml for the local PostgreSQL and GreenMail containers.
POSTGRES_PASSWORD=phishtriage
IMAP_PASSWORD=demo-mailbox-password

# ----------------------------------------------------------------- report mailbox
# The compose file points these at GreenMail. For a real mailbox use IMAPS (port 993).
# IMAP_HOST=imap.example.edu
# IMAP_PORT=993
# IMAP_SSL=true
# IMAP_USER=report-phishing@example.edu
# IMAP_MAILBOX=INBOX
# IMAP_PROCESSED_MAILBOX=Processed
# IMAP_REJECTED_MAILBOX=Rejected
# POLL_INTERVAL_SECONDS=30

# ----------------------------------------------------------------- verdict replies
# The compose file sends replies to Mailpit (http://localhost:8025). Replies go only to
# reporters in policy.org_domains whose report passed DMARC (see docs/mailbox.md).
# REPLIES_ENABLED=true
# REPLY_FROM=PhishTriage <report-phishing@example.edu>
# REPLY_HOURLY_LIMIT=20
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
SMTP_PASSWORD=

# ----------------------------------------------------------------- threat intelligence
# Optional. Without a key the lookup is skipped and everything else works.
# VirusTotal: https://www.virustotal.com/gui/my-apikey
#   The free public API allows 4 requests/minute and 500/day and must not be used in
#   commercial products or services; a real deployment needs a paid licence.
VT_API_KEY=
# URLhaus: free Auth-Key from https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
# Limits (defaults match the free VirusTotal API; see docs/intel.md):
# VT_RATE_PER_MINUTE=4
# VT_DAILY_BUDGET=500
# VT_MAX_LOOKUPS_PER_REPORT=4
# INTEL_MAX_WAIT_SECONDS=60
# INTEL_TIMEOUT_SECONDS=10
# RDAP needs no key and only contacts the servers in app/intel/rdap_bootstrap.json.
# RDAP_ENABLED=true
